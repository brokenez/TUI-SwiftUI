    "import { imgBullet } from \"./svg-ezn5q\";\n\nexport default function ListBulleted() {\n  return (\n    <div className=\"content-stretch flex flex-col items-start pb-[var(--spacing\\/paragraph-spacing,16px)] relative size-full\" data-node-id=\"25085:11908\" data-name=\"List Bulleted\">\n      <div className=\"content-stretch flex gap-[8px] items-start pb-[4px] pl-[6px] pt-px relative shrink-0 w-full\" data-node-id=\"I25085:11908;9460:7064\" data-name=\"Item\">\n        <div className=\"h-[24px] relative shrink-0 w-[8px]\" data-node-id=\"I25085:11908;9460:7064;9460:7060\" data-name=\"Bullet\">\n          <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgBullet} />\n        </div>\n        <p className=\"[word-break:break-word] flex-[1_0_0] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] max-w-[700px] min-w-px not-italic relative text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I25085:11908;9460:7064;9460:7062\">\n          На айосе увеличиваем шрифты по обычным правилам динамик тайпа\n        </p>\n      </div>\n      <div className=\"content-stretch flex gap-[8px] items-start pb-[4px] pl-[6px] relative shrink-0 w-full\" data-node-id=\"I25085:11908;9460:7070\" data-name=\"Item\">\n        <div className=\"h-[24px] relative shrink-0 w-[8px]\" data-node-id=\"I25085:11908;9460:7070;9460:7060\" data-name=\"Bullet\">\n          <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgBullet} />\n        </div>\n        <p className=\"[word-break:break-word] flex-[1_0_0] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] max-w-[700px] min-w-px not-italic relative text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I25085:11908;9460:7070;9460:7062\">\n          Иконку увеличиваем только в AX1 режиме\n        </p>\n      </div>\n      <div className=\"content-stretch flex gap-[8px] items-start pb-[4px] pl-[6px] relative shrink-0 w-full\" data-node-id=\"I25085:11908;9460:7077\" data-name=\"Item\">\n        <div className=\"h-[24px] relative shrink-0 w-[8px]\" data-node-id=\"I25085:11908;9460:7077;9460:7060\" data-name=\"Bullet\">\n          <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgBullet} />\n        </div>\n        <p className=\"[word-break:break-word] flex-[1_0_0] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] max-w-[700px] min-w-px not-italic relative text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I25085:11908;9460:7077;9460:7062\">{`При увеличении шрифтов высота кнопки подстраивается под высоту текстового лейбла с минимальными отступами, при этом минимальная высота кнопки сохраняется `}</p>\n      </div>\n      <div className=\"content-stretch flex gap-[8px] items-start pb-[4px] pl-[6px] relative shrink-0 w-full\" data-node-id=\"I25085:11908;9460:7082\" data-name=\"Item\">\n        <div className=\"h-[24px] relative shrink-0 w-[8px]\" data-node-id=\"I25085:11908;9460:7082;9460:7060\" data-name=\"Bullet\">\n          <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgBullet} />\n        </div>\n        <p className=\"[word-break:break-word] flex-[1_0_0] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] max-w-[700px] min-w-px not-italic relative text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I25085:11908;9460:7082;9460:7062\">\n          Если текст лейбла не помещается, то добавляем фейд в конце текста\n        </p>\n      </div>\n      <div className=\"content-stretch flex gap-[8px] items-start pb-[4px] pl-[6px] relative shrink-0 w-full\" data-node-id=\"I25085:11908;9460:7087\" data-name=\"Item\">\n        <div className=\"h-[24px] relative shrink-0 w-[8px]\" data-node-id=\"I25085:11908;9460:7087;9460:7060\" data-name=\"Bullet\">\n          <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgBullet} />\n        </div>\n        <p className=\"[word-break:break-word] flex-[1_0_0] font-['Neue_Haas_Unica_W1G:Regular'] leading-[0] max-w-[700px] min-w-px not-italic relative text-[0px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I25085:11908;9460:7087;9460:7062\">\n          <span className=\"leading-[24px] text-[15px]\">{`Если в кнопке с двумя лейблами длинный текст, сохраняется поведение `}</span>\n          <a className=\"[text-underline-position:from-font] cursor-pointer decoration-from-font decoration-solid leading-[24px] text-[#428bf9] text-[15px] underline\" href=\"List Bulleted\" target=\"_self\">\n            <span className=\"[text-underline-position:from-font] decoration-from-font decoration-solid underline\" href=\"List Bulleted\" target=\"_self\">\n              по умолчанию\n            </span>\n          </a>\n        </p>\n      </div>\n    </div>\n  );\n}",
