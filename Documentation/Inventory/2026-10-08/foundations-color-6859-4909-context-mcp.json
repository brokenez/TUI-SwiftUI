n        </div>\n        <div className=\"content-stretch flex gap-[8px] items-start pb-[4px] pl-[6px] relative shrink-0 w-full\" data-node-id=\"I6859:4915;9460:7070\" data-name=\"Item\">\n          <div className=\"h-[24px] relative shrink-0 w-[8px]\" data-node-id=\"I6859:4915;9460:7070;9460:7060\" data-name=\"Bullet\">\n            <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgBullet} />\n          </div>\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['Neue_Haas_Unica_W1G:Regular'] leading-[0] max-w-[700px] min-w-px not-italic relative text-[0px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I6859:4915;9460:7070;9460:7062\">\n            <span className=\"font-['Neue_Haas_Unica_W1G:Medium'] leading-[24px] text-[15px]\">color</span>\n            <span className=\"leading-[24px] text-[15px]\">{` — значение цвета для точек остановки через запятую`}</span>\n          </p>\n        </div>\n        <div className=\"content-stretch flex gap-[8px] items-start pb-[4px] pl-[6px] relative shrink-0 w-full\" data-node-id=\"I6859:4915;9460:7077\" data-name=\"Item\">\n          <div className=\"h-[24px] relative shrink-0 w-[8px]\" data-node-id=\"I6859:4915;9460:7077;9460:7060\" data-name=\"Bullet\">\n            <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgBullet} />\n          </div>\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['Neue_Haas_Unica_W1G:Medium'] leading-[0] max-w-[700px] min-w-px not-italic relative text-[0px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I6859:4915;9460:7077;9460:7062\">\n            <span className=\"leading-[24px] text-[15px]\">position</span>\n            <span className=\"font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] text-[#333] text-[15px]\">{` — точки остановки от 0 до 1, где 0 — 0%, а 1 — `}</span>\n            <span className=\"font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] t