      "type": "text",
      "text": "import { imgColor, imgBullet, imgStart, imgColorSchema } from \"./svg-z4dft\";\ntype H2PProps = {\n  className?: string;\n  showBadge?: boolean;\n  showParagraph?: boolean;\n  titleText?: string;\n};\n\nfunction H2P({ className, showBadge = false, showParagraph = true, titleText = \"## H2\" }: H2PProps) {\n  const isNotShowParagraph = !showParagraph;\n  return (\n    <div className={className || \"content-stretch flex flex-col items-start pb-[var(--indents\\\\/bottom-indent-l,32px)] pt-[var(--indents\\\\/top-indent-s,16px)] relative w-[934px]\"} id={isNotShowParagraph ? \"node-19647_26628\" : \"node-19647_26627\"}>\n      <div className=\"content-stretch flex gap-[10px] items-start relative shrink-0 w-full\" id={isNotShowParagraph ? \"node-19647_26635\" : \"node-19647_26629\"} data-name=\"## H2\">\n        <p className=\"[word-break:break-word] flex-[1_0_0] font-['T-Sans:Medium'] leading-[40px] min-w-px not-italic relative text-[36px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"19647:26630\" style={{ fontFeatureSettings: '\"liga\" 0' }}>\n          {titleText}\n        </p>\n        {showBadge && (\n          <div className=\"content-stretch flex flex-col items-start pt-[8px] relative self-stretch shrink-0\" data-node-id=\"19647:26631\" data-name=\"badge\">\n            {showBadge && (\n              <div className=\"backdrop-blur-[5px] bg-[var(--UIColor.tui.background.neutral4,rgba(0,16,36,0.22))] content-stretch flex items-center justify-center min-h-[28px] min-w-[28px] px-[6px] relative rounded-[100px] shrink-0\" data-node-id=\"19647:26632\" data-name=\"tui-badge\">\n                <div className=\"content-stretch flex flex-col h-[28px] items-center justify-center py-[4px] relative shrink-0\" data-node-id=\"I19647:26632;6917:52779\" data-name=\"IconCont\">\n                  <div className=\"relative shrink-0 size-[16px]\" data-node-id=\"I19647:26632;6917:52780\" data-name=\"tui-ic-small / bookmark-filled\">\n                    <div className=\"absolute bg-[var(--UIColor.tui.text.primaryOnDark,white)] inset-0 mask-alpha mask-intersect mask-no-clip mask-no-repeat mask-position-[3.8px_2px] mask-size-[8.4px_11.954px]\" data-node-id=\"I19647:26632;6917:52780;7545:352\" style={{ maskImage: `url(\"${imgColor}\")` }} data-name=\"Color\" />\n                  </div>\n                </div>\n                <div className=\"content-stretch flex flex-col items-center justify-center pb-[6.5px] pt-[5.5px] px-[4px] relative shrink-0\" data-node-id=\"I19647:26632;6917:52781\" data-name=\"LabelCont\">\n                  <p className=\"[word-break:break-word] font-['SF_Pro_Text:Semibold'] leading-[normal] not-italic relative shrink-0 text-[13px] text-[color:var(--UIColor.tui.text.primaryOnDark,white)] text-center tracking-[-0.08px] whitespace-nowrap\" data-node-id=\"I19647:26632;6917:52782\">\n                    story-name\n                  </p>\n                </div>\n              </div>\n            )}\n          </div>\n        )}\n      </div>\n      {showParagraph && (\n        <div className=\"content-stretch flex flex-col items-start pt-[8px] relative shrink-0 w-full\" data-node-id=\"19647:26633\" data-name=\"Paragraph\">\n          <p className=\"[word-break:break-word] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] max-w-[700px] not-italic relative shrink-0 text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)] w-full\" data-node-id=\"19647:26634\">\n            Paragraph\n          </p>\n        </div>\n      )}\n    </div>\n  );\n}\n\nexport default function Component() {\n  return (\n    <div className=\"bg-[var(--figma-library\\/guide-artboard,white)] content-stretch flex flex-col items-start overflow-clip p-[var(--paddings\\/artboard-padding,128px)] relative rounded-[var(--roundings\\/artboard-rounding,80px)] size-full\" data-node-id=\"6859:4909\" data-name=\"Представление в коде\">\n      <div className=\"content-stretch flex flex-col items-start pb-[var(--indents\\/bottom-indent-l,32px)] relative shrink-0 w-[934px]\" data-node-id=\"6859:4910\" data-name=\"H1 + P\">\n        <div className=\"content-stretch flex gap-[10px] items-center relative shrink-0 w-full\" data-node-id=\"I6859:4910;4925:362\" data-name=\"# H1\">\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['T-Sans:Bold'] leading-[56px] min-w-px not-italic relative text-[50px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I6859:4910;9499:6973\" style={{ fontFeatureSettings: '\"liga\" 0' }}>\n            Представление в коде\n          </p>\n        </div>\n      </div>\n      <div className=\"content-stretch flex flex-col items-start pb-[var(--indents\\/bottom-indent-l,32px)] pt-[var(--indents\\/top-indent-s,16px)] relative shrink-0 w-[934px]\" data-node-id=\"6859:4911\" data-name=\"H2 + P\">\n        <div className=\"content-stretch flex gap-[10px] items-start relative shrink-0 w-full\" data-node-id=\"I6859:4911;2130:381\" data-name=\"## H2\">\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['T-Sans:Medium'] leading-[40px] min-w-px not-italic relative text-[36px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I6859:4911;9459:8641\" style={{ fontFeatureSettings: '\"liga\" 0' }}>\n            Токен цвета\n          </p>\n        </div>\n        <div className=\"content-stretch flex flex-col items-start pt-[8px] relative shrink-0 w-full\" data-node-id=\"I6859:4911;9462:7169\" data-name=\"Paragraph\">\n          <p className=\"[word-break:break-word] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] max-w-[700px] not-italic relative shrink-0 text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)] w-full\" data-node-id=\"I6859:4911;9462:7170\">\n            Переменные цвета в Figma представлены в виде композитных токенов в коде, которые могут иметь несколько параметров:\n          </p>\n        </div>\n      </div>\n      <div className=\"content-stretch flex flex-col items-start overflow-clip pb-[var(--spacing\\/paragraph-spacing,16px)] relative shrink-0 w-[934px]\" data-node-id=\"6859:4912\" data-name=\"List Bulleted\">\n        <div className=\"content-stretch flex gap-[8px] items-start pb-[4px] pl-[6px] pt-px relative shrink-0 w-full\" data-node-id=\"I6859:4912;9460:7064\" data-name=\"Item\">\n          <div className=\"h-[24px] relative shrink-0 w-[8px]\" data-node-id=\"I6859:4912;9460:7064;9460:7060\" data-name=\"Bullet\">\n            <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgBullet} />\n          </div>\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['Neue_Haas_Unica_W1G:Regular'] leading-[0] max-w-[700px] min-w-px not-italic relative text-[0px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I6859:4912;9460:7064;9460:7062\">\n            <span className=\"font-['Neue_Haas_Unica_W1G:Medium'] leading-[24px] text-[15px]\">{`value `}</span>\n            <span className=\"leading-[24px] text-[15px]\">— значение по умолчанию для всех платформ, используется в дневной и ночной темах, если нет других параметров</span>\n          </p>\n        </div>\n        <div className=\"content-stretch flex gap-[8px] items-start pb-[4px] pl-[6px] relative shrink-0 w-full\" data-node-id=\"I6859:4912;9460:7070\" data-name=\"Item\">\n          <div className=\"h-[24px] relative shrink-0 w-[8px]\" data-node-id=\"I6859:4912;9460:7070;9460:7060\" data-name=\"Bullet\">\n            <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgBullet} />\n          </div>\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['Neue_Haas_Unica_W1G:Regular'] leading-[0] max-w-[700px] min-w-px not-italic relative text-[0px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I6859:4912;9460:7070;9460:7062\">\n            <span className=\"font-['Neue_Haas_Unica_W1G:Medium'] leading-[24px] text-[15px]\">darkValue</span>\n            <span className=\"leading-[24px] text-[15px]\">{` — значение для тёмной темы на всех платформах`}</span>\n          </p>\n        </div>\n        <div className=\"content-stretch flex gap-[8px] items-start pb-[4px] pl-[6px] relative shrink-0 w-full\" data-node-id=\"I6859:4912;9460:7077\" data-name=\"Item\">\n          <div className=\"h-[24px] relative shrink-0 w-[8px]\" data-node-id=\"I6859:4912;9460:7077;9460:7060\" data-name=\"Bullet\">\n            <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgBullet} />\n          </div>\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['Neue_Haas_Unica_W1G:Medium'] leading-[0] max-w-[700px] min-w-px not-italic relative text-[0px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I6859:4912;9460:7077;9460:7062\">\n            <span className=\"leading-[24px] text-[15px]\">desktopValue/desktopDarkValue</span>\n            <span className=\"font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] text-[#333] text-[15px]\">{` — заменяют значения Value/darkValue для Desktop платформы в дневной и ночной темах соответственно`}</span>\n          </p>\n        </div>\n        <div className=\"content-stretch flex gap-[8px] items-start pb-[4px] pl-[6px] relative shrink-0 w-full\" data-node-id=\"I6859:4912;9460:7082\" data-name=\"Item\">\n          <div className=\"h-[24px] relative shrink-0 w-[8px]\" data-node-id=\"I6859:4912;9460:7082;9460:7060\" data-name=\"Bullet\">\n            <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgBullet} />\n          </div>\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['Neue_Haas_Unica_W1G:Medium'] leading-[0] max-w-[700px] min-w-px not-italic relative text-[0px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I6859:4912;9460:7082;9460:7062\">\n            <span className=\"leading-[24px] text-[15px]\">androidValue/androidDarkValue</span>\n            <span className=\"font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] text-[#333] text-[15px]\">{` — заменяют значения Value/darkValue для Android платформы в дневной и ночной темах соответственно`}</span>\n          </p>\n        </div>\n        <div className=\"content-stretch flex gap-[8px] items-start pb-[4px] pl-[6px] relative shrink-0 w-full\" data-node-id=\"I6859:4912;9460:7087\" data-name=\"Item\">\n          <div className=\"h-[24px] relative shrink-0 w-[8px]\" data-node-id=\"I6859:4912;9460:7087;9460:7060\" data-name=\"Bullet\">\n            <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgBullet} />\n          </div>\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['Neue_Haas_Unica_W1G:Regular'] leading-[0] max-w-[700px] min-w-px not-italic relative text-[0px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I6859:4912;9460:7087;9460:7062\">\n            <span className=\"leading-[24px] text-[15px]\">{`Если `}</span>\n            <span className=\"font-['Neue_Haas_Unica_W1G:Medium'] leading-[24px] text-[15px]\">value: null</span>\n            <span className=\"leading-[24px] text-[15px]\">{` и/или `}</span>\n            <span className=\"font-['Neue_Haas_Unica_W1G:Medium'] leading-[24px] text-[15px]\">androidValue: null</span>\n            <span className=\"leading-[24px] text-[15px]\">, значит цвет уникален для десктопа</span>\n          </p>\n        </div>\n      </div>\n      <div className=\"content-stretch flex flex-col gap-[var(--spacing\\/description-spacing,16px)] items-start overflow-clip pb-[var(--indents\\/bottom-indent-l,32px)] relative shrink-0 w-[934px]\" data-node-id=\"6859:4913\" data-name=\"Image 1x1\">\n        <div className=\"content-stretch flex flex-col gap-[436px] items-start overflow-clip relative rounded-[var(--roundings\\/image-rounding,24px)] shrink-0 w-full\" data-node-id=\"I6859:4913;9469:7126\" data-name=\"Image Placeholder\">\n          <div className=\"h-0 relative shrink-0 w-full\" dat