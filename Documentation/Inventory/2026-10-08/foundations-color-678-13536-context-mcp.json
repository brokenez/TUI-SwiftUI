    {
      "type": "text",
      "text": "import { imgStart } from \"./svg-bnap9\";\nconst img2024050615211 = \"/Users/v.shtukert/Documents/TUI-Design-System/Documentation/References/Foundations/DesktopAssets/bbd86c44918b55c8603ca21a4531768bd26bb39f.png\";\nconst imgPalette1 = \"/Users/v.shtukert/Documents/TUI-Design-System/Documentation/References/Foundations/DesktopAssets/c2dd29ebe528b8831b2b77441cd5aa0f42c9d7da.png\";\nconst imgScreenshot20240426At13581 = \"/Users/v.shtukert/Documents/TUI-Design-System/Documentation/References/Foundations/DesktopAssets/1813e3ca0f8b6814fa4108e764215a8e9fd3dec7.png\";\nconst img2024042213221 = \"/Users/v.shtukert/Documents/TUI-Design-System/Documentation/References/Foundations/DesktopAssets/830cc3a448ccc8f60527ee74551f1850d2a06800.png\";\n\nexport default function Component() {\n  return (\n    <div className=\"bg-[var(--figma-library\\/guide-artboard,white)] content-stretch flex flex-col items-start overflow-clip p-[var(--paddings\\/artboard-padding,128px)] relative rounded-[var(--roundings\\/artboard-rounding,80px)] size-full\" data-node-id=\"678:13536\" data-name=\"Часто задаваемые вопросы\">\n      <div className=\"content-stretch flex flex-col items-start pb-[var(--indents\\/bottom-indent-l,32px)] relative shrink-0 w-[934px]\" data-node-id=\"678:13537\" data-name=\"H1 + P\">\n        <div className=\"content-stretch flex gap-[10px] items-center relative shrink-0 w-full\" data-node-id=\"I678:13537;4925:367\" data-name=\"# H1\">\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['T-Sans:Bold'] leading-[56px] min-w-px not-italic relative text-[50px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I678:13537;9459:8631\" style={{ fontFeatureSettings: '\"liga\" 0' }}>\n            Часто задаваемые вопросы\n          </p>\n        </div>\n        <div className=\"content-stretch flex flex-col items-start pt-[20px] relative shrink-0 w-full\" data-node-id=\"I678:13537;9462:7159\" data-name=\"Paragraph\">\n          <p className=\"[word-break:break-word] font-['Neue_Haas_Unica_W1G:Regular'] leading-[0] max-w-[700px] not-italic relative shrink-0 text-[0px] text-[color:var(--UIColor.tui.text.primary,#333)] w-full\" data-node-id=\"I678:13537;9462:7160\">\n            <span className=\"leading-[24px] text-[15px]\">Если не нашли ответ, пишите в ~</span>\n            <a className=\"[text-decoration-skip-ink:none] [text-underline-position:from-font] cursor-pointer decoration-from-font decoration-solid leading-[24px] text-[15px] underline\" href=\"https://time.tinkoff.ru/tinkoff/channels/tui-design-ask\" target=\"_blank\">\n              <span className=\"[text-decoration-skip-ink:none] [text-underline-position:from-font] decoration-from-font decoration-solid underline\" href=\"https://time.tinkoff.ru/tinkoff/channels/tui-design-ask\" target=\"_blank\">\n                tui-design-ask\n              </span>\n            </a>\n          </p>\n        </div>\n      </div>\n      <div className=\"content-stretch flex flex-col items-start pb-[var(--indents\\/bottom-indent-l,32px)] pt-[var(--indents\\/top-indent-s,16px)] relative shrink-0 w-[934px]\" data-node-id=\"678:13538\" data-name=\"H2 + P\">\n        <div className=\"content-stretch flex gap-[10px] items-start relative shrink-0 w-full\" data-node-id=\"I678:13538;2130:381\" data-name=\"## H2\">\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['T-Sans:Medium'] leading-[40px] min-w-px not-italic relative text-[36px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I678:13538;9459:8641\" style={{ fontFeatureSettings: '\"liga\" 0' }}>\n            Во что красить иконки?\n          </p>\n        </div>\n        <div className=\"content-stretch flex flex-col items-start pt-[8px] relative shrink-0 w-full\" data-node-id=\"I678:13538;9462:7169\" data-name=\"Paragraph\">\n          <p className=\"[word-break:break-word] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] max-w-[700px] not-italic relative shrink-0 text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)] w-full\" data-node-id=\"I678:13538;9462:7170\">\n            Чтобы не дублировать одни и те же цвета, иконки красятся в токены текста.\n          </p>\n        </div>\n      </div>\n      <div className=\"content-stretch flex flex-col gap-[var(--spacing\\/description-spacing,16px)] items-start overflow-clip pb-[var(--indents\\/bottom-indent-l,32px)] relative shrink-0 w-[934px]\" data-node-id=\"3721:9862\" data-name=\"Image 1x1\">\n        <div className=\"content-stretch flex flex-col gap-[442px] items-center justify-center overflow-clip relative rounded-[var(--roundings\\/image-rounding,24px)] shrink-0 w-full\" data-node-id=\"I3721:9862;9469:7126\" data-name=\"Image Placeholder\">\n          <div className=\"h-0 relative shrink-0 w-full\" data-node-id=\"I3721:9862;9469:7126;622:2060\" data-name=\"Start\">\n            <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgStart} />\n          </div>\n          <div className=\"h-0 relative shrink-0 w-full\" data-node-id=\"I3721:9862;9469:7126;622:2061\" data-name=\"End\">\n            <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgStart} />\n          </div>\n          <div className=\"absolute bg-[var(--figma-library\\/guide-image,#f6f7f8)] inset-0 rounded-[var(--roundings\\/image-rounding,24px)]\" data-node-id=\"I3721:9862;9469:7126;5375:1825\" data-name=\"Content Appearance\" />\n          <div className=\"absolute content-stretch flex inset-0 items-center justify-center p-[60px]\" data-node-id=\"I3721:9862;9469:7126;622:2066\" data-name=\"textcont\">\n            <p className=\"[word-break:break-word] flex-[1_0_0] font-['Tinkoff_Sans:Medium'] leading-[32px] min-w-px not-italic relative text-[38px] text-[color:var(--UIColor.tui.text.primary,#333)] text-center\" data-node-id=\"I3721:9862;9469:7126;622:2065\" style={{ fontFeatureSettings: '\"liga\" 0' }}>\n              Иконка = символ = текст\n            </p>\n          </div>\n          <p className=\"[word-break:break-word] absolute bottom-[-10px] font-['SF_Pro_Text:Regular'] leading-[normal] left-0 not-italic right-0 text-[14px] text-black translate-y-full\" data-node-id=\"I3721:9862;9469:7126;8349:7213\">\n            ...\n          </p>\n        </div>\n      </div>\n      <div className=\"content-stretch flex flex-col items-start pb-[var(--indents\\/bottom-indent-l,32px)] pt-[var(--indents\\/top-indent-s,16px)] relative shrink-0 w-[934px]\" data-node-id=\"678:13540\" data-name=\"H2 + P\">\n        <div className=\"content-stretch flex gap-[10px] items-start relative shrink-0 w-full\" data-node-id=\"I678:13540;2130:381\" data-name=\"## H2\">\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['T-Sans:Medium'] leading-[40px] min-w-px not-italic relative text-[36px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I678:13540;9459:8641\" style={{ fontFeatureSettings: '\"liga\" 0' }}>\n            У меня цвета стали какие-то бледные\n          </p>\n        </div>\n        <div className=\"content-stretch flex flex-col items-start pt-[8px] relative shrink-0 w-full\" data-node-id=\"I678:13540;9462:7169\" data-name=\"Paragraph\">\n          <p className=\"[word-break:break-word] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] max-w-[700px] not-italic relative shrink-0 text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)] w-full\" data-node-id=\"I678:13540;9462:7170\">{`Это из-за того, что в мобиле и десктопе отличаются некоторые значения, а по умолчанию выставляется режим iOS. Если ваши декстоп макеты стали бледными, нужно выставить Mode Desktop на уровне фрейма, а лучше на уровне всей страницы. `}</p>\n        </div>\n      </div>\n      <div className=\"content-stretch flex flex-col items-start overflow-clip pb-[var(--spacing\\/paragraph-spacing,16px)] relative shrink-0 w-[934px]\" data-node-id=\"678:13541\" data-name=\"List Bulleted\">\n        <div className=\"content-stretch flex gap-[4px] items-start pb-[4px] pl-[6px] pt-px relative shrink-0 w-full\" data-node-id=\"I678:13541;9460:7064\" data-name=\"Item\">\n          <div className=\"content-stretch flex items-start relative self-stretch shrink-0\" data-node-id=\"I678:13541;9460:7064;9460:7135\" data-name=\"Bullet\">\n            <p className=\"[word-break:break-word] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] not-italic relative shrink-0 text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)] whitespace-nowrap\" data-node-id=\"I678:13541;9460:7064;9460:7139\">\n              1.\n            </p>\n          </div>\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] max-w-[700px] min-w-px not-italic relative text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I678:13541;9460:7064;9460:7137\">\n            Снимите фокус с выбранного элемента — можно нажать на пустое место на холсте\n          </p>\n        </div>\n        <div className=\"content-stretch flex gap-[4px] items-start pb-[4px] pl-[6px] relative shrink-0 w-full\" data-node-id=\"I678:13541;9460:7070\" data-name=\"Item\">\n          <div className=\"content-stretch flex items-start relative self-stretch shrink-0\" data-node-id=\"I678:13541;9460:7070;9460:7135\" data-name=\"Bullet\">\n            <p className=\"[word-break:break-word] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] not-italic relative shrink-0 text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)] whitespace-nowrap\" data-node-id=\"I678:13541;9460:7070;9460:7139\">\n              2.\n            </p>\n          </div>\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] max-w-[700px] min-w-px not-italic relative text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I678:13541;9460:7070;9460:7137\">\n            Нажмите значок шестеренки справа вверху в секции Page\n          </p>\n        </div>\n        <div className=\"content-stretch flex gap-[4px] items-start pb-[4px] pl-[6px] relative shrink-0 w-full\" data-node-id=\"I678:13541;9460:7077\" data-name=\"Item\">\n          <div className=\"content-stretch flex items-start relative self-stretch shrink-0\" data-node-id=\"I678:13541;9460:7077;9460:7135\" data-name=\"Bullet\">\n            <p className=\"[word-break:break-word] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] not-italic relative shrink-0 text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)] whitespace-nowrap\" data-node-id=\"I678:13541;9460:7077;9460:7139\">\n              3.\n            </p>\n          </div>\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['Neue_Haas_Unica_W1G:Regular'] font-normal leading-[24px] max-w-[700px] min-w-px relative text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I678:13541;9460:7077;9460:7137\" style={{ fontVariationSettings: '\"CTGR\" 0, \"wdth\" 100' }}>\n            Выберите Theme → Desktop\n          </p>\n        </div>\n      </div>\n      <div className=\"content-stretch flex flex-col items-start overflow-clip pb-[48px] relative rounded-[24px] shrink-0 w-[934px]\" data-node-id=\"678:13542\" data-name=\"card-text-1x1\">\n        <div className=\"bg-[var(--figma-library\\/guide-image,#f6f7f8)] h-[493px] relative rounded-[24px] shrink-0 w-full\" data-node-id=\"678:13543\" data-name=\"card-container\">\n          <div className=\"absolute h-[413px] left-[493px] opacity-50 rounded-[2px] top-[40px] w-[241px]\" data-node-id=\"678:13544\" data-name=\"Снимок экрана 2024-05-06 в 15.21 1\">\n            <div className=\"absolute inset-0 overflow-hidden pointer-events-none rounded-[2px]\">\n              <img alt=\"\" className=\"absolute h-[100.24%] left-[-121.78%] max-w-none top-[-0.24%] w-[221.16%]\" src={img2024050615211} />\n            </div>\n          </div>\n          <div className=\"absolute left-[693.5px] rounded-[2px] size-[30px] top-[90px]\" data-node-id=\"678:13545\" data-name=\"Снимок экрана 2024-05-06 в 15.21 4\">\n            <div className=\"absolute inset-0 overflow-hidden pointer-events-none rounded-[2px]\">\n              <img alt=\"\" className=\"absolute h-[1380%] left-[-1647.05%] max-w-none top-[-170%] w-[1776.67%]\" src={img2024050615211} />\n            </div>\n          </div>\n          <div className=\"absolute h-[206px] left-[524px] rounded-[2px] top-[121px] w-[200px]\" data-node-id=\"678:13546\" data-name=\"Снимок экрана 2024-05-06 в 15.21 2\">\n            <div className=\"absolute inset-0 overflow-hidden pointer-events-none rounded-[2px]\">\n              <img alt=\"\" className=\"absolute h-[200.97%] left-[-162.25%] max-w-none top-[-39.81%] w-[266.5%]\" src={img2024050615211} />\n            </div>\n          </div>\n          <div className=\"absolute h-[129px] left-[325px] rounded-[2px] top-[263px] w-[199px]\" data-node-id=\"678:13547\" data-name=\"Снимок экрана 2024-05-06 в 15.21 3\">\n            <div className=\"absolute inset-0 overflow-hidden pointer-events-none rounded-[2px]\">\n              <img alt=\"\" className=\"absolute h-[320.93%] left-[-63.07%] max-w-none top-[-173.64%] w-[267.84%]\" src={img2024050615211} />\n            </div>\n          </div>\n        </div>\n      </div>\n      <div className=\"content-stretch flex flex-col items-start pb-[var(--indents\\/bottom-indent-l,32px)] pt-[var(--indents\\/top-indent-s,16px)] relative shrink-0 w-[934px]\" data-node-id=\"678:13548\" data-name=\"H2 + P\">\n        <div className=\"content-stretch flex gap-[10px] items-start relative shrink-0 w-full\" data-node-id=\"I678:13548;2130:381\" data-name=\"## H2\">\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['T-Sans:Medium'] leading-[40px] min-w-px not-italic relative text-[36px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I678:13548;9459:8641\" style={{ fontFeatureSettings: '\"liga\" 0' }}>\n            Не совпадают HEX цветов между макетами и кодом\n          </p>\n        </div>\n        <div className=\"content-stretch flex flex-col items-start pt-[8px] relative shrink-0 w-full\" data-node-id=\"I678:13548;9462:7169\" data-name=\"Paragraph\">\n          <p className=\"[word-break:break-word] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] max-w-[700px] not-italic relative shrink-0 text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)] w-full\" data-node-id=\"I678:13548;9462:7170\">\n            Проверьте что на фреймах, где отличаются цвета выставлен нужный mode палитры. Для десктопа это должен быть Desktop, для мобилы iOS или Android\n          </p>\n        </div>\n      </div>\n      <div className=\"content-stretch flex flex-col items-start pb-[var(--indents\\/bottom-indent-l,32px)] pt-[var(--indents\\/top-indent-s,16px)] relative shrink-0 w-full\" data-node-id=\"678:13549\" data-name=\"H2 + P\">\n        <div className=\"content-stretch flex gap-[10px] items-start relative shrink-0 w-full\" data-node-id=\"I678:13549;2130:381\" data-name=\"## H2\">\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['T-Sans:Medium'] leading-[40px] min-w-px not-italic relative text-[36px] text-[color:var(--UIColor.tui.text.primary,#333)] whitespace-pre-wrap\" data-node-id=\"I678:13549;9459:8641\" style={{ fontFeatureSettings: '\"liga\" 0' }}>\n            {`Когда хочу выбрать цвет, вижу сообщение `}\n            <br aria-hidden />\n            «No colors Avaliable»\n          </p>\n        </div>\n        <div className=\"content-stretch flex flex-col items-start pt-[8px] relative shrink-0 w-full\" data-node-id=\"I678:13549;9462:7169\" data-name=\"Paragraph\">\n          <p className=\"[word-break:break-word] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] max-w-[700px] not-italic relative shrink-0 text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)] w-full\" data-node-id=\"I678:13549;9462:7170\">{`Нужно выбрать библиотеку TUI Foundations из выпадающего меню `}</p>\n        </div>\n      </div>\n      <div className=\"content-stretch flex flex-col items-start overflow-clip pb-[48px] relative rounded-[24px] shrink-0 w-[934px]\" data-node-id=\"678:13550\" data-name=\"card-text-1x1\">\n        <div className=\"bg-[var(--figma-library\\/guide-image,#f6f7f8)] h-[425px] relative rounded-[24px] shrink-0 w-full\" data-node-id=\"678:13551\" data-name=\"card-container\">\n          <div className=\"absolute h-[361px] left-[34px] rounded-[8px] top-[32px] w-[866px]\" data-node-id=\"678:13552\" data-name=\"palette 1\">\n            <img alt=\"\" className=\"absolute inset-0 max-w-none mix-blend-multiply object-cover pointer-events-none rounded-[8px] size-full\" src={imgPalette1} />\n          </div>\n        </div>\n      </div>\n      <div className=\"content-stretch flex flex-col items-start pb-[var(--indents\\/bottom-indent-l,32px)] pt-[var(--indents\\/top-indent-s,16px)] relative shrink-0 w-full\" data-node-id=\"678:13553\" data-name=\"H2 + P\">\n        <div className=\"content-stretch flex gap-[10px] items-start relative shrink-0 w-full\" data-node-id=\"I678:13553;2130:381\" data-name=\"## H2\">\n          <p className=\"[word-break:break-word] flex-[1_0_0] font-['T-Sans:Medium'] leading-[40px] min-w-px not-italic relative text-[36px] text-[color:var(--UIColor.tui.text.primary,#333)]\" data-node-id=\"I678:13553;9459:8641\" style={{ fontFeatureSettings: '\"liga\" 0' }}>\n            Макет был в темной теме, а стал в светлой\n          </p>\n        </div>\n        <div className=\"content-stretch flex flex-col items-start pt-[8px] relative shrink-0 w-full\" data-node-id=\"I678:13553;9462:7169\" data-name=\"Paragraph\">\n          <p className=\"[word-break:break-word] font-['Neue_Haas_Unica_W1G:Regular'] leading-[24px] max-w-[700px] not-italic relative shrink-0 text-[15px] text-[color:var(--UIColor.tui.text.primary,#333)] w-full\" data-node-id=\"I678:13553;9462:7170\">\n        